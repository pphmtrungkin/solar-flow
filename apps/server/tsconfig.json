{
  "extends": "@solar-sales/config/tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
    },
    "skipLibCheck": true,
    "types": ["bun"],
    "typeRoots": ["./node_modules/@types"],
  },
  "include": ["src/**/*.ts"],
  "exclude": ["../packages/**", "../../packages/**", "../../packages/**/**"],
}
