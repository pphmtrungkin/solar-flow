{
  "name": "solar-sales",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@types/bun": "^1.3.4",
      "better-auth": "^1.4.18",
      "@prisma/client": "^7.2.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @solar-sales/db db:push",
    "db:studio": "turbo -F @solar-sales/db db:studio",
    "db:generate": "turbo -F @solar-sales/db db:generate",
    "db:migrate": "turbo -F @solar-sales/db db:migrate",
    "db:start": "turbo -F @solar-sales/db db:start",
    "db:watch": "turbo -F @solar-sales/db db:watch",
    "db:stop": "turbo -F @solar-sales/db db:stop",
    "db:down": "turbo -F @solar-sales/db db:down",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.5.3",
    "@hono/standard-validator": "^0.2.2",
    "@scalar/hono-api-reference": "^0.9.46",
    "@solar-sales/env": "workspace:*",
    "@valibot/to-json-schema": "^1.5.0",
    "dotenv": "^17.3.1",
    "hono-openapi": "^1.2.0",
    "hono-pino": "^0.10.3",
    "pino": "^10.3.1",
    "prisma-openapi": "^1.6.0",
    "prisma-valibot-generator": "^1.2.0",
    "stoker": "^2.0.1",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@solar-sales/config": "workspace:*",
    "@types/bun": "^1.3.9",
    "turbo": "^2.8.12",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.6"
}
