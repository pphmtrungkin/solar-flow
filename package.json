{
  "name": "solar-sales",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@types/bun": "^1.3.4",
      "better-auth": "^1.4.18",
      "@prisma/client": "^7.2.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @solar-sales/db db:push",
    "db:studio": "turbo -F @solar-sales/db db:studio",
    "db:generate": "turbo -F @solar-sales/db db:generate",
    "db:migrate": "turbo -F @solar-sales/db db:migrate",
    "db:start": "turbo -F @solar-sales/db db:start",
    "db:watch": "turbo -F @solar-sales/db db:watch",
    "db:stop": "turbo -F @solar-sales/db db:stop",
    "db:down": "turbo -F @solar-sales/db db:down",
    "db:reset": "turbo -F @solar-sales/db db:reset",
    "db:seed": "turbo -F @solar-sales/db db:seed",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.2",
    "@hono/standard-validator": "^0.2.2",
    "@prisma/client": "^7.8.0",
    "@scalar/hono-api-reference": "^0.9.48",
    "@solar-sales/env": "workspace:*",
    "@types/react": "^19.2.14",
    "@valibot/to-json-schema": "^1.6.0",
    "better-auth": "^1.6.2",
    "daisyui": "^5.5.23",
    "dotenv": "^17.4.1",
    "hono-openapi": "^1.3.0",
    "hono-pino": "^0.10.3",
    "input-otp": "^1.4.2",
    "nodemailer": "^8.0.5",
    "pino": "^10.3.1",
    "prisma": "^7.8.0",
    "prisma-openapi": "^1.6.0",
    "prisma-valibot-generator": "^1.2.0",
    "react-email": "^5.2.10",
    "stoker": "^2.0.1",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@solar-sales/config": "workspace:*",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bun": "^1.3.12",
    "@types/nodemailer": "^8.0.0",
    "turbo": "^2.9.18",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.6"
}
